<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Private=false + ExcludeAssets=runtime means: use the host app's types
          at compile time, but do NOT copy CassieLauncher.dll (or its
          Avalonia dependencies) into this plugin's own build output.

          This matters — if a second copy of the host assembly ends up sitting
          next to the plugin DLL, PluginLoadContext will load it into its own
          context, and the launcher's "is IFnPlugin" check will fail, because
          that copy of IFnPlugin is technically a different type to the .NET
          runtime even though the source is identical. Keeping Private=false
          means this plugin always binds against the launcher's own already-
          loaded copy instead.
        -->
        <ProjectReference Include="..\Launcher-main\CassieLauncher.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

</Project>
